# Cloudera AI Inference (CAIIS) template — copy to .env
# cp .env.caiis.example .env

CAIIS_BASE_URL=https://ai-inference.YOUR-DOMAIN/namespaces/serving-default/endpoints/YOUR-MODEL/v1
CAIIS_MODEL=nvidia/nemotron-3-nano
# Reasoning models (e.g. nemotron-3-nano) need max_tokens >= 1024 for the content field to populate
CAIIS_MAX_TOKENS=1024

# CDP auth token (Bearer). In CDSW sessions, /tmp/jwt is read automatically if unset.
# CDP_TOKEN=your-cdp-bearer-token

# Default sidebar to CAIIS when CAIIS_BASE_URL is set (also auto-detected without this)
DEFAULT_LLM_PROVIDER=caiis

# Optional Llama Guard 3 on CAII (sidebar: Safety Check Engine → Llama Guard 3)
# LLAMA_GUARD_BASE_URL=https://ai-inference.YOUR-DOMAIN/namespaces/serving-default/endpoints/llama-guard-3/openai/v1
# LLAMA_GUARD_MODEL=meta-llama/Llama-Guard-3-8B
# DEFAULT_SAFETY_MODE=llama_guard

# Guardrails centralized server (recommended)
# CDSW often uses 8001 when 8000 is taken — match start_guardrails_server.sh output
GUARDRAILS_PORT=8001
GUARDRAILS_SERVER_URL=http://127.0.0.1:8001

# Streamlit / CDSW
# STREAMLIT_PORT=8090
# CDSW_APP_PORT=8090
