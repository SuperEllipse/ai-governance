# OpenAI provider template — copy to .env
# cp .env.openai.example .env

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Guardrails centralized server (recommended)
# CDSW often uses 8001 when 8000 is taken — match start_guardrails_server.sh output
GUARDRAILS_PORT=8001
GUARDRAILS_SERVER_URL=http://127.0.0.1:8001

# Streamlit / CDSW
# STREAMLIT_PORT=8090
# CDSW_APP_PORT=8090
