# OpenAI provider template — copy to .env
# cp .env.openai.example .env

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Guardrails centralized server (recommended)
GUARDRAILS_SERVER_URL=http://localhost:8000
GUARDRAILS_PORT=8000

# Streamlit / CDSW
# STREAMLIT_PORT=8090
# CDSW_APP_PORT=8090
