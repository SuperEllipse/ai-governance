# Default template — copy to .env and fill in values. Never commit .env to git.
#
# Provider-specific templates:
#   cp .env.openai.example .env   # OpenAI
#   cp .env.caiis.example .env    # Cloudera AI Inference (CAIIS)

# --- OpenAI (default provider for app testing) ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: default sidebar provider (openai | caiis). Auto-selects caiis when CAIIS is configured.
# DEFAULT_LLM_PROVIDER=caiis

# --- Cloudera AI Inference (CAIIS — optional; select in sidebar or set DEFAULT_LLM_PROVIDER=caiis) ---
# Local / CDSW: full URL in .env
# CAIIS_BASE_URL=https://ai-inference.YOUR-DOMAIN/namespaces/serving-default/endpoints/YOUR-MODEL/v1
# CAII Application deploy (env values restricted — use parts, not full URLs):
# CAIIS_HOST=ml-YOUR-CLUSTER-ID.YOUR-CAI-DOMAIN
# CAIIS_ENDPOINT=mpark-nemotron
# CAIIS_NAMESPACE=serving-default
# CAIIS_API_PATH=openai
# CAIIS_MODEL=nvidia/nemotron-3-nano
# CAII Application deploy (model id contains `/` — use org+name parts):
# CAIIS_MODEL_ORG=nvidia
# CAIIS_MODEL_NAME=nemotron-3-nano
# Reasoning models (e.g. nemotron-3-nano) need max_tokens >= 1024 for the content field to populate
# CAIIS_MAX_TOKENS=1024
# CDP_TOKEN=your-cdp-bearer-token

# --- Guardrails centralized server (recommended) ---
# CDSW often uses 8001 when 8000 is taken — match start_guardrails_server.sh output
GUARDRAILS_PORT=8001
GUARDRAILS_SERVER_URL=http://127.0.0.1:8001
# Multi-app (Cloudera AI Applications): point Streamlit app at the guardrails app's public URL:
# GUARDRAILS_SERVER_URL=https://nemo-guardrails.YOUR-CAI-DOMAIN
# Or hostname-only for CAII Application env restrictions:
# GUARDRAILS_HOST=nemo-guardrails.YOUR-CAI-DOMAIN

# --- Streamlit / platform ports (injected by CAI Workbench or CAII; do not hardcode in Application mode) ---
# STREAMLIT_PORT=8090
# CAI Workbench Application:
# CDSW_APP_PORT=8090
# CAII Application (must listen on APP_PORT, default 8080):
# APP_PORT=8080
# Optional guardrails CAI Workbench Application: pick which platform port to bind
# CAI_BIND_PORT_KEY=CDSW_READONLY_PORT
# Optional platform override when auto-detect is ambiguous:
# DEPLOY_PLATFORM=cai
# DEPLOY_PLATFORM=caii

# --- NVIDIA NIM safety model (optional sidebar toggle; default is self_check) ---
# NVIDIA_API_KEY=your-nvidia-api-key
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Llama Guard 3 on CAII (optional safety check alternative to self_check) ---
# LLAMA_GUARD_BASE_URL=https://ai-inference.YOUR-DOMAIN/namespaces/serving-default/endpoints/llama-guard-3/openai/v1
# LLAMA_GUARD_HOST=ml-YOUR-CLUSTER-ID.YOUR-CAI-DOMAIN
# LLAMA_GUARD_ENDPOINT=llama-guard-3
# LLAMA_GUARD_MODEL=meta-llama/Llama-Guard-3-8B
# LLAMA_GUARD_MODEL_ORG=meta-llama
# LLAMA_GUARD_MODEL_NAME=Llama-Guard-3-8B
# DEFAULT_SAFETY_MODE=llama_guard
