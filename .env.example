# Default template — copy to .env and fill in values. Never commit .env to git.
#
# Provider-specific templates:
#   cp .env.openai.example .env   # OpenAI
#   cp .env.caiis.example .env    # Cloudera AI Inference (CAIIS)

# --- OpenAI (default provider) ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Cloudera AI Inference (CAIIS — uncomment and set when using CAIIS) ---
# CAIIS_BASE_URL=https://ai-inference.YOUR-DOMAIN/namespaces/serving-default/endpoints/YOUR-MODEL/v1
# CAIIS_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
# CDP_TOKEN=your-cdp-bearer-token

# --- Guardrails centralized server (recommended) ---
# CDSW often uses 8001 when 8000 is taken — match start_guardrails_server.sh output
GUARDRAILS_PORT=8001
GUARDRAILS_SERVER_URL=http://127.0.0.1:8001

# --- Streamlit / CDSW ports ---
# STREAMLIT_PORT=8090
# CDSW_APP_PORT=8090

# --- NVIDIA NIM safety model (optional sidebar toggle; default is self_check) ---
# NVIDIA_API_KEY=your-nvidia-api-key
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
