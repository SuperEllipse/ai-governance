# Default template — OpenAI for local/dev testing.
# Copy to .env and fill in values. Never commit .env to git.
#
# Optional provider-specific templates:
#   cp .env.openai.example .env   # OpenAI (recommended for first run)
#   cp .env.caiis.example .env    # Cloudera AI Inference (production workbench)

# --- OpenAI (default for testing) ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Cloudera AI Inference (production — uncomment and set when deploying) ---
# CAIIS_BASE_URL=https://ai-inference.YOUR-DOMAIN/namespaces/serving-default/endpoints/YOUR-MODEL/v1
# CAIIS_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
# CDP_TOKEN=your-cdp-bearer-token

# --- Guardrails centralized server (recommended for workbench deployment) ---
GUARDRAILS_SERVER_URL=http://localhost:8000
GUARDRAILS_PORT=8000

# --- Streamlit / CDSW ports ---
# STREAMLIT_PORT=8090
# CDSW_APP_PORT=8090

# --- NVIDIA NIM safety model (optional sidebar toggle; default is self_check) ---
# NVIDIA_API_KEY=your-nvidia-api-key
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
